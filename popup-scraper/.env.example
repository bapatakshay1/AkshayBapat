# ---- Instagram (instagrapi / private API) ----
# Use a dedicated / burner account. Automating a personal account violates
# Instagram's Terms of Service and can get it rate-limited or banned.
IG_USERNAME=your_instagram_username
IG_PASSWORD=your_instagram_password
# Optional: path where the logged-in session is cached so you don't re-login every run.
IG_SESSION_FILE=./ig_session.json

# ---- Claude vision model ----
ANTHROPIC_API_KEY=sk-ant-...
# Any vision-capable Claude model. Sonnet is a good cost/quality default.
VISION_MODEL=claude-sonnet-5

# ---- Twilio SMS ----
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
# The number (or Messaging Service SID) blasts are sent from.
TWILIO_FROM_NUMBER=+15551234567

# ---- App config ----
# SQLite database for dedup, subscribers, and detections.
DATABASE_PATH=./popup_scraper.db
# Path to the YAML list of artist handles to follow / watch.
ARTISTS_FILE=./artists.yaml
# Minimum confidence (0-1) from the vision model before a blast goes out.
CONFIDENCE_THRESHOLD=0.7
# How many recent posts to check per artist each run.
POSTS_PER_ARTIST=5
# Seconds between polls when running `watch`.
POLL_INTERVAL_SECONDS=1800
# Set to "console" to print texts instead of sending them (safe for testing).
NOTIFIER=twilio
